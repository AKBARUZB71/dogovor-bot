# BotFather bergan token. Hech qachon kodga yoki git'ga qo'ymang.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Telegram user ID'lari, vergul bilan. ID'ni @userinfobot orqali bilish mumkin.
ADMIN_IDS=111111111,222222222

# Baza fayli (Docker'da /app/data/dogovor.db)
DB_PATH=data/dogovor.db

# Oxirgi ishlatilgan raqam. FAQAT yangi, bo'sh baza yaratilganda qo'llanadi.
# Mavjud bazada bu qiymatni o'zgartirish hisoblagichga ta'sir qilmaydi.
INITIAL_LAST_NUMBER=2729

# Takroriy bosishdan himoya (soniya)
DEBOUNCE_SECONDS=5

# Yuborilmagan xabar uchun maksimal urinishlar soni
OUTBOX_MAX_ATTEMPTS=10

LOG_LEVEL=INFO
